# Copy to .env for local development. Never commit .env.

APP_NAME="Stockroom"
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Defaults to a SQLite file in ./instance. In production use Postgres, e.g.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# DATABASE_URL=

# --- Sign-in (OpenID Connect) ---
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
#   Authorized redirect URI: https://<your-host>/auth/callback  (and http://localhost:5000/auth/callback)
# Any other OIDC provider works too: set OIDC_DISCOVERY_URL and OIDC_PROVIDER_NAME.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# OIDC_PROVIDER_NAME=Microsoft

# Optional: only accept sign-ins/new users from these domains (comma separated).
# ALLOWED_EMAIL_DOMAINS=example.edu

# This email becomes a superuser the first time it signs in.
SUPERUSER_EMAIL=you@example.com

# Local development only: debug mode, plus a sign-in box that accepts any email without OAuth.
# The app refuses to start with DEV_LOGIN unless FLASK_DEBUG is on.
FLASK_DEBUG=1
DEV_LOGIN=true

# --- Email notifications (optional; without these, emails are logged) ---
MAIL_FROM="Stockroom <stockroom@example.com>"
# Either an HTTP API key from https://resend.com ...
# RESEND_API_KEY=
# ... or any SMTP server.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
